{
  "name": "jinxiao-system",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "进销通 v2.0 — 运行在 Cloudflare Workers 上的企业级进销存与二级分销管理系统（D1 + R2 + Workers Assets）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:ci": "node scripts/ensure-r2.mjs && wrangler deploy && wrangler d1 migrations apply jinxiao-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply jinxiao-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply jinxiao-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/bcryptjs": "^3.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}